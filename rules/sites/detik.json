{
  "$schema": "../schema.json",
  "id": "detik",
  "name": "detikcom",
  "domains": ["detik.com"],
  "articleUrl": "/d-\\d+/",
  "body": [".detail__body-text"],
  "remove": [
    "table.linksisip",
    ".noncontent",
    ".lihatjg",
    ".detail__body-tag",
    ".sisip_video_ds",
    ".aevp",
    ".dugout-video",
    ".ratio-dugout-detail"
  ],
  "dropParagraphs": ["^simak juga video\\b"],
  "pagination": {
    "method": "param",
    "fullpage": "single=1",
    "stripPathPage": true,
    "onlyIf": ".detail__long-nav, .detail__anchor-numb"
  },
  "feed": "https://news.detik.com/rss",
  "samples": [
    "https://news.detik.com/berita/d-8746131/pkb-pertimbangkan-hak-menyatakan-pendapat-terkait-polemik-gibran"
  ],
  "verified": "2026-11-10",
  "notes": "No paginated article found in ~260 sampled (news, hot, wolipop, finance, travel, food). /2 redirects to ?page=2, so paging still exists; single=1 comes from AutoAllPage and is unverified here. CNN Indonesia runs on the same platform (see cnnindonesia.json)."
}
