<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: find the user's browser to hand non-article pages to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sapu">

        <!-- Launcher: one-time setup (turn on news links, try an article). -->
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives links to the news sites the user approved under "Open by default".
             Invisible: articles go to the reader, other pages to the user's browser. -->
        <activity
            android:name=".RouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Sapu.Router">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <!-- sapu:hosts:start (generated by `npm run build` from rules/sites; do not edit) -->
                <data android:host="antaranews.com" />
                <data android:host="*.antaranews.com" />
                <data android:host="bisnis.com" />
                <data android:host="*.bisnis.com" />
                <data android:host="cnbcindonesia.com" />
                <data android:host="*.cnbcindonesia.com" />
                <data android:host="cnnindonesia.com" />
                <data android:host="*.cnnindonesia.com" />
                <data android:host="detik.com" />
                <data android:host="*.detik.com" />
                <data android:host="inews.id" />
                <data android:host="*.inews.id" />
                <data android:host="jpnn.com" />
                <data android:host="*.jpnn.com" />
                <data android:host="kompas.com" />
                <data android:host="*.kompas.com" />
                <data android:host="liputan6.com" />
                <data android:host="*.liputan6.com" />
                <data android:host="merdeka.com" />
                <data android:host="*.merdeka.com" />
                <data android:host="okezone.com" />
                <data android:host="*.okezone.com" />
                <data android:host="republika.co.id" />
                <data android:host="*.republika.co.id" />
                <data android:host="suara.com" />
                <data android:host="*.suara.com" />
                <data android:host="tirto.id" />
                <data android:host="*.tirto.id" />
                <data android:host="tribunnews.com" />
                <data android:host="*.tribunnews.com" />
                <data android:host="viva.co.id" />
                <data android:host="*.viva.co.id" />
                <!-- sapu:hosts:end -->
            </intent-filter>
        </activity>

        <!-- The clean reader: a WebView with the Sapu Berita script injected. -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
    </application>
</manifest>
