{
  "name": "bacabersih",
  "version": "0.0.0",
  "private": true,
  "description": "Clean reading overlay for Indonesian news sites. One core script, wrapped for iOS Shortcuts, an Android link router and a desktop dev extension.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "build:rules": "node tools/build-rules.ts",
    "import:adblock": "node tools/import-adblock.ts",
    "import:autoallpage": "node tools/import-autoallpage.ts",
    "capture": "node tools/capture-fixture.ts",
    "canary": "node tools/canary.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
