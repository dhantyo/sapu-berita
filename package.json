{
  "name": "sapu-berita",
  "version": "0.3.2",
  "private": true,
  "description": "Clean reading overlay for Indonesian news sites. One core script, wrapped for an Apple Shortcut, an Android app and a browser extension.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "build:rules": "node tools/build-rules.ts",
    "import:adblock": "node tools/import-adblock.ts",
    "import:autoallpage": "node tools/import-autoallpage.ts",
    "capture": "node tools/capture-fixture.ts",
    "probe": "node tools/probe-site.ts",
    "preview": "node tools/preview.ts",
    "rebaseline": "node tools/rebaseline-fixtures.ts",
    "canary": "node tools/canary.ts",
    "inspect": "node tools/inspect.ts",
    "fixtures:pull": "node tools/saved-pages.ts pull",
    "fixtures:push": "node tools/saved-pages.ts push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.49.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
